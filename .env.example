# ===== Database (Postgres) =====
# Otomatis terisi jika Anda menghubungkan Neon lewat Vercel > Storage.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ===== Login admin (hanya Anda) =====
ADMIN_USERNAME=admin
# Gunakan password yang panjang & unik (min. 12 karakter).
ADMIN_PASSWORD=
# String acak min. 32 karakter. Buat dengan: openssl rand -base64 48
AUTH_SECRET=

# ===== Telegram =====
# Token dari @BotFather, contoh: 123456789:AAH...
TELEGRAM_BOT_TOKEN=
# Chat ID Anda (bisa dicari dari menu Admin > Pengaturan Telegram)
TELEGRAM_CHAT_ID=

# ===== Vercel Cron =====
# String acak; Vercel otomatis mengirimkannya saat menjalankan cron.
CRON_SECRET=

# ===== Opsional =====
NEXT_PUBLIC_SITE_NAME=Nama Anda
